#!/usr/bin/env bash
# Re-light the internal panel (eDP-2) after a resume/undock.
#
# On the Framework 16 (AMD), undocking triggers an s2idle suspend/resume and the
# amdgpu DMUB display engine fully re-inits. Hyprland/aquamarine sometimes fails
# to re-modeset the internal panel, leaving it black and unresponsive. A single
# `hyprctl dispatch dpms on` races the DMUB re-init and only works sometimes, so
# force DPMS on + re-apply the monitor, retrying until the panel reports on.

set -u

mon="eDP-2"
mode="2560x1600@165,auto,1.25"

for _ in 1 2 3 4 5 6; do
    hyprctl dispatch dpms on "$mon"      >/dev/null 2>&1
    hyprctl keyword monitor "${mon},${mode}" >/dev/null 2>&1

    sleep 1

    state=$(hyprctl monitors -j 2>/dev/null \
        | jq -r --arg m "$mon" '.[] | select(.name==$m) | .dpmsStatus')
    [ "$state" = "true" ] && exit 0
done

# Fallback: the panel may have re-enumerated under a different name.
hyprctl dispatch dpms on >/dev/null 2>&1
exit 0
